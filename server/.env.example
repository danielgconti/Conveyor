# Copy to server/.env for running the API/worker on the host (npm run dev:api / dev:worker).
# docker-compose.yml sets these itself. See src/config.ts for every option and default.

DATABASE_URL=postgresql://conveyor:conveyor@localhost:5432/conveyor
REDIS_URL=redis://localhost:6379
QUEUE_DRIVER=bullmq          # bullmq | sqs
STORAGE_DRIVER=local         # local | s3
ARTIFACTS_DIR=./data/artifacts
LOG_LEVEL=info

# AWS (QUEUE_DRIVER=sqs / STORAGE_DRIVER=s3)
# AWS_REGION=us-east-1
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/conveyor-jobs
# S3_BUCKET=conveyor-artifacts

# Worker
WORKER_CONCURRENCY=2
JOB_NETWORK_MODE=none        # Docker network for job containers; "none" = no network
JOB_CONTAINER_USER=65534:65534
PULL_MISSING_IMAGES=false
# ALLOWED_IMAGE_PREFIXES=conveyor/
